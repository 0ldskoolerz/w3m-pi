# BusyBox config para W3M Linux (fragmento sobre el default de Buildroot)
# applets clave habilitados; el resto queda default.

CONFIG_ASH=y
CONFIG_ASH_BUILTIN_ECHO=y
CONFIG_ASH_JOB_CONTROL=y
CONFIG_MDEV=y
CONFIG_MDEV_AUTO_EJECT=y
CONFIG_UDHCPC=y
CONFIG_UDHCPC_DEFAULT_SCRIPT="/usr/share/udhcpc/default.script"
CONFIG_IFCONFIG=y
CONFIG_ROUTE=y
CONFIG_IP=y
CONFIG_PING=y
CONFIG_TRACEROUTE=y
CONFIG_HWCLOCK=y
CONFIG_NTPD=y
CONFIG_INIT=y
CONFIG_GETTY=y
CONFIG_LOGIN=y
CONFIG_SU=y
CONFIG_PASSWD=y
CONFIG_SULOGIN=y
CONFIG_MOUNT=y
CONFIG_UMOUNT=y
CONFIG_FDISK=y
CONFIG_MKFS_EXT2=y
CONFIG_TAR=y
CONFIG_UNZIP=y
CONFIG_GZIP=y
CONFIG_AWK=y
CONFIG_LESS=y
CONFIG_VI=y
CONFIG_LS=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_RM=y
CONFIG_MKDIR=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_FREE=y
CONFIG_DF=y
CONFIG_LSPCI=y
CONFIG_LSUSB=y
CONFIG_SYSLOGD=y
CONFIG_KLOGD=y
# extras headless de w3m-pi
CONFIG_UDHCPC=y
CONFIG_UDHPD=y
CONFIG_Iwgetid=y
CONFIG_NC_SERVER=y
CONFIG_TFTP=y
CONFIG_TFTPD=y
CONFIG_TELNET=y
CONFIG_TELNETD=y
CONFIG_HTTPD=y
CONFIG_FTPGET=y
CONFIG_FTPPUT=y
CONFIG_CHAT=y

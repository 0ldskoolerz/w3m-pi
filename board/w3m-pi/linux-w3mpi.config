# Kernel config para Raspberry Pi Zero W (w3m-pi, headless)
# Base: bcm2835_defconfig del kernel RaspberryPi + ajustes headless.

CONFIG_ARM=y
CONFIG_ARCH_BCM2835=y

# ---- minimos del SoC ----
CONFIG_MACH_BCM2835=y

# ---- UART (consola serie para acceso remoto por GPIO) ----
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# ---- SD/eMMC ----
CONFIG_MMC=y
CONFIG_MMC_BCM2835_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_BLK_DEV_LOOP=y

# ---- filesystems ----
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CP437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# ---- wifi onboard (BCM43438) ----
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_RFKILL=y

# ---- USB (gadget para OTG/consola USB si hiciera falta) ----
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DWC2=y
CONFIG_USB_G_SERIAL=y

# ---- temperatura/clock del SoC (raspinfo) ----
CONFIG_THERMAL=y
CONFIG_BCM2835_THERMAL=y

# ---- GPIO (utilidades pi) ----
CONFIG_GPIO_SYSFS=y

# ---- red TCP/IP ----
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IPV6=y
CONFIG_IP_MULTICAST=y

# ---- IPv4 forwarding/AP mode ----
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NF_TABLES=y
CONFIG_NFT_NAT=y
CONFIG_NETFILTER=y

# ---- DMA/SDIO necesarios del BCM2835 ----
CONFIG_DMADEVICES=y
CONFIG_DMA_BCM2835=y

# ---- sin framebuffer/X (headless): descarta video pesado ----
# CONFIG_FB is not set
# CONFIG_SOUND is not set

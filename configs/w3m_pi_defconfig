# w3m-pi — Buildroot defconfig para Raspberry Pi Zero W (BCM2835, armv6l)
# Headless: sin X11, herramientas de red + acceso remoto.
# Uso: make BR2_EXTERNAL=/ruta/w3m-pi w3m_pi_defconfig

# ---- placas y herramientas ----
BR2_arm=y
BR2_cortex_a6=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV5_EABI_GLIBC_STABLE=y
# (armv6l: toolchain armv5 eabi compatible con BCM2835)

# rootfs overlay con nuestros scripts
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_W3MPI_PATH)/board/w3m-pi/rootfs-overlay"
BR2_TARGET_GENERIC_HOSTNAME="w3m-pi"
BR2_TARGET_GENERIC_ISSUE="w3m-pi — herramientas de red en tu Pi Zero W"
BR2_TARGET_GENERIC_ROOT_PASSWD="w3mpi"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y

# ---- kernel Raspberry Pi ----
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/raspberrypi/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="1.20240312"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_W3MPI_PATH)/board/w3m-pi/linux-w3mpi.config"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="bcm2835-rpi-zero-w"

# dtb del Pi Zero W al arranque
BR2_LINUX_KERNEL_INSTALL_DTB=y
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_W3MPI_PATH)/board/w3m-pi/config.txt"

# ---- busybox userland ----
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL_W3MPI_PATH)/board/w3m-pi/busybox-w3mpi.config"

# ---- filesystems ----
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y

# ==== HERRAMIENTAS DE RED (el nucleo de la distro) ====

# wifi del Pi Zero W (BCM43438)
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_TOOLS=y

# AP mode (rescate) + DNS/DHCP
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_HOSTAP=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_DNSMASQ=y

# diagnostico (suite w3m-net en CLI)
BR2_PACKAGE_NET_TOOLS=y
BR2_PACKAGE_TRACEROUTE=y
BR2_PACKAGE_NMAP=y
BR2_PACKAGE_TCPDUMP=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y

# acceso remoto
BR2_PACKAGE_DROPBEAR=y
# cliente ssh para salir (debug desde la pi)
BR2_PACKAGE_DROPBEAR_CLIENT=y

# pi especifico
BR2_PACKAGE_RPI_USERLAND=y

# ---- salida: imagen SD ----
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# RPi0W: boot por FAT + rootfs
BR2_PACKAGE_RPI_FIRMWARE_BOOT_CONFIG_FILE="$(BR2_EXTERNAL_W3MPI_PATH)/board/w3m-pi/config.txt"
